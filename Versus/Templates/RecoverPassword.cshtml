@model Versus.Models.TemplateModels.NewPasswordTemplateModel;

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
</head>
<body>
    <h2>Olá, @Model.UserName</h2>
    <p>Recebemos a sua solicitação de recuperação de senha, por favor clique no link abaixo dentro de 30 minutos para redefinir a sua senha!</p>
    <a href="@Model.ResetLink">Redefinir Senha</a>
    <br />
    <p>Atenciosamente, equipe VersuS</p>
    <p>E-mail enviado automáticamente, por favor não responda!</p>
</body>
</html>

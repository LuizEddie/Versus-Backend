@model Versus.Models.TemplateModels.NewPasswordTemplateModel;

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
</head>
<body>
    <h2>Olá, @Model.UserName</h2>
    <p>Bem-Vindo ao <strong>VersuS</strong>, a plataforma definitiva para gerenciamento de torneios.</p>
    <p>Recebemos a sua solicitação, por favor clique no link abaixo dentro de 30 minutos para definir a sua senha e finalizar o seu cadastro!</p>
    <a href="@Model.ResetLink">Definir senha e finalizar cadastro</a>
    <br />
    <p>Atenciosamente, equipe VersuS</p>
    <p>E-mail enviado automáticamente, por favor não responda!</p>
</body>
</html>
